<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E1F22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF252629"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9CA3AF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF1E1F22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF356FB8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Gar.Brush.WindowBackground" Color="#FF1E1F22"/>
    <SolidColorBrush x:Key="Gar.Brush.WindowText" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.ControlBackground" Color="#FF2B2D30"/>
    <SolidColorBrush x:Key="Gar.Brush.ControlText" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.ControlBorder" Color="#FF5F656D"/>
    <SolidColorBrush x:Key="Gar.Brush.ControlDisabledText" Color="#FF8C8C8C"/>
    <SolidColorBrush x:Key="Gar.Brush.InputBackground" Color="#FF202225"/>
    <SolidColorBrush x:Key="Gar.Brush.InputInactiveBackground" Color="#FF252B33"/>
    <SolidColorBrush x:Key="Gar.Brush.ButtonBackground" Color="#FF33363B"/>
    <SolidColorBrush x:Key="Gar.Brush.MenuBackground" Color="#FF252629"/>
    <SolidColorBrush x:Key="Gar.Brush.MenuText" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.ToolbarBackground" Color="#FF252629"/>
    <SolidColorBrush x:Key="Gar.Brush.StatusBarBackground" Color="#FF252629"/>
    <SolidColorBrush x:Key="Gar.Brush.ListBackground" Color="#FF1E1F22"/>
    <SolidColorBrush x:Key="Gar.Brush.ListText" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.ListAlternateBackground1" Color="#FF23252A"/>
    <SolidColorBrush x:Key="Gar.Brush.ListAlternateBackground2" Color="#FF1E1F22"/>
    <SolidColorBrush x:Key="Gar.Brush.ListHoverBackground" Color="#FF303743"/>
    <SolidColorBrush x:Key="Gar.Brush.ListSelectedBackground" Color="#FF356FB8"/>
    <SolidColorBrush x:Key="Gar.Brush.ListSelectedText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Gar.Brush.ListInactiveSelectedBackground" Color="#FF3A4658"/>
    <SolidColorBrush x:Key="Gar.Brush.PreviewBackground" Color="#FF151515"/>
    <SolidColorBrush x:Key="Gar.Brush.Splitter" Color="#FF686868"/>
    <LinearGradientBrush x:Key="Gar.Brush.SectionHeaderBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF303A4A" Offset="0"/>
        <GradientStop Color="#FF242B36" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Gar.Brush.SectionHeaderText" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.Accent" Color="#FF5EA1F2"/>
    <SolidColorBrush x:Key="Gar.Brush.AccentText" Color="#FF0B1220"/>
    <SolidColorBrush x:Key="Gar.Brush.Error" Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Gar.Brush.Warning" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="Gar.Brush.FocusOutline" Color="#FF5EA1F2"/>
    <SolidColorBrush x:Key="Gar.Brush.ScrollbarTrack" Color="#FF242629"/>
    <SolidColorBrush x:Key="Gar.Brush.ScrollbarThumb" Color="#FF555B64"/>
    <SolidColorBrush x:Key="Gar.Brush.ScrollbarThumbHover" Color="#FF68707B"/>
    <SolidColorBrush x:Key="Gar.Brush.ScrollbarThumbPressed" Color="#FF7A8491"/>
    <SolidColorBrush x:Key="Gar.Brush.Icon" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Gar.Brush.IconMuted" Color="#FFBFC6D1"/>
    <SolidColorBrush x:Key="Gar.Brush.Hyperlink" Color="#FF8AB4F8"/>
    <SolidColorBrush x:Key="Gar.Brush.TextSelectionBackground" Color="#FF356FB8"/>
    <SolidColorBrush x:Key="Gar.Brush.TextSelectionText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Gar.Brush.ToolTipBackground" Color="#FF2F3136"/>
    <SolidColorBrush x:Key="Gar.Brush.ToolTipText" Color="#FFE8E8E8"/>
</ResourceDictionary>
