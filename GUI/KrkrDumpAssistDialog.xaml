<Window x:Class="GARbro.GUI.KrkrDumpAssistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Orientation="Vertical" Margin="10" Width="520">
        <TextBlock x:Name="SourceArchiveLabel"/>
        <TextBox x:Name="SourceArchiveBox" Margin="0,2,0,8" IsReadOnly="True"/>

        <TextBlock x:Name="GameExecutableLabel"/>
        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GameExecutableBox" Grid.Column="0" Height="23"/>
            <Button x:Name="BrowseExeButton" Grid.Column="1" Width="75" Height="23" Margin="8,0,0,0"
                    Click="BrowseExe_Click"/>
        </Grid>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,10"/>
        <TextBlock x:Name="RuntimeNoticeText" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="Collapsed"/>

        <Separator Height="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenKrkrDumpButton" Width="150" Height="25" Margin="0,0,10,0"
                    Visibility="Collapsed" Click="OpenKrkrDump_Click"/>
            <Button x:Name="RunButton" Width="110" Height="25" IsDefault="True"
                    Click="RunButton_Click"/>
            <Button x:Name="CancelButton" Width="75" Height="25" IsCancel="True"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
