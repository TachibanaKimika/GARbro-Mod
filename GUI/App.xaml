<Application x:Class="GARbro.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System"
             StartupUri="MainWindow.xaml" Startup="ApplicationStartup"
             ShutdownMode="OnMainWindowClose" Exit="ApplicationExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Shared.xaml"/>
                <ResourceDictionary Source="Themes/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Uri x:Key="DevLink">https://github.com/TachibanaKimika/GARbro-Mod#readme</sys:Uri>
            <sys:Uri x:Key="DevIssuesLink">https://github.com/TachibanaKimika/GARbro-Mod/issues</sys:Uri>
            <sys:Uri x:Key="UpdateUrl">https://raw.githubusercontent.com/TachibanaKimika/GARbro-Mod/master/docs/version.xml</sys:Uri>
            <BitmapImage x:Key="IconSearch" UriSource="pack://application:,,,/Images/search4files.ico" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
