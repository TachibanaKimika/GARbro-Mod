<StackPanel x:Class="GameRes.Formats.GUI.WidgetXP3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:GameRes.Formats.GUI"
      MaxWidth="320" Orientation="Vertical" HorizontalAlignment="Left">
    <StackPanel.Resources>
        <local:ClassNameConverter x:Key="ClassNameConverter" />
    </StackPanel.Resources>
    <ComboBox Name="Scheme" Width="180" ItemsSource="{Binding}" HorizontalAlignment="Left"
              DisplayMemberPath="Name" SelectedValuePath="Key"
              SelectionChanged="OnSchemeSelectionChanged"/>
    <TextBlock Name="AlgorithmName" DataContext="{Binding ElementName=Scheme, Path=SelectedItem}" Margin="0,5,0,0"
               Text="{Binding Path=Value, Mode=OneWay}"/>
            <Button Name="KrkrDumpButton" Width="180" Margin="0,8,0,0"
                    HorizontalAlignment="Left" Click="OnKrkrDumpClick"/>
            <TextBlock Name="KrkrDumpStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
</StackPanel>
